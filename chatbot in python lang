def chatbot():
    print("🤖 Chatbot: Hello! Type 'bye' to exit.")

    while True:
        user = input("You: ").lower()

        if user == "hello" or user == "hi":
            print("🤖 Chatbot: Hello! How are you?")

        elif "name" in user:
            print("🤖 Chatbot: I am a simple Python chatbot.")

        elif "how are you" in user:
            print("🤖 Chatbot: I'm doing great! Thanks for asking.")

        elif "bca" in user:
            print("🤖 Chatbot: BCA is a great field for learning programming and technology.")

        elif "ai" in user or "machine learning" in user:
            print("🤖 Chatbot: AI and Machine Learning are exciting fields to explore!")

        elif user == "bye":
            print("🤖 Chatbot: Goodbye! Have a great day! 👋")
            break

        else:
            print("🤖 Chatbot: Sorry, I don't understand that.")

chatbot()
